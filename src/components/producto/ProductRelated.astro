---
import type { ProductDetailView } from '@/lib/server/catalog/product-detail'
import { formatProductPrice } from '@/lib/utils/currency'
import { getProductPrice, hasClubPrice } from '@/lib/catalog/pricing'

interface Props {
    view: ProductDetailView
}

const { view } = Astro.props
const { relacionados, isAuthenticated, eyebrowClass, sectionTitleClass } = view
---

{
    relacionados.length > 0 && (
        <section class="bg-sunka-white">
            <div class="mx-auto max-w-7xl px-5 py-14 md:px-8 md:py-16">
                <p class={eyebrowClass}>Completa tu ritual</p>
                <h2 class={sectionTitleClass}>Descubre lo que resuena contigo.</h2>

                <div class="mt-10 grid grid-cols-1 gap-7 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
                    {relacionados.map((item) => (
                        <a
                            class="group flex h-full min-w-0 flex-col bg-sunka-cream px-5 pb-5 pt-5 shadow-[0_6px_16px_rgba(35,29,24,0.12)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_10px_22px_rgba(35,29,24,0.16)]"
                            href={`/productos/${item.slug}`}
                        >
                            <div class="grid aspect-[1.08] place-items-center overflow-hidden bg-sunka-cream">
                                {item.photo ? (
                                    <img
                                        src={item.photo}
                                        alt={item.name}
                                        loading="lazy"
                                        class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-[1.04]"
                                    />
                                ) : (
                                    <span class="font-heading tracking-[0.1em]">SUNKA</span>
                                )}
                            </div>
                            <div class="mt-5">
                                <h3 class="text-base font-semibold text-sunka-ink">
                                    {item.name}
                                </h3>
                                {item.short_description && (
                                    <p class="mt-1 line-clamp-2 text-xs leading-relaxed text-sunka-stone">
                                        {item.short_description}
                                    </p>
                                )}
                                <div class="mt-2 flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
                                    <strong class="block text-sm font-semibold text-sunka-ink">
                                        S/ {formatProductPrice(getProductPrice(item, isAuthenticated))}
                                    </strong>
                                    {
                                        hasClubPrice(item) && (
                                            <span class="text-[10px] text-sunka-stone">
                                                {isAuthenticated
                                                    ? `Regular: S/ ${formatProductPrice(item.price)}`
                                                    : `Club: S/ ${formatProductPrice(item.club_price)}`}
                                            </span>
                                        )
                                    }
                                </div>
                            </div>
                        </a>
                    ))}
                </div>
            </div>
        </section>
    )
}
