---
import BaseLayout from '@/layouts/BaseLayout.astro'
import OrigenHero from '@/components/origen/OrigenHero.astro'
import OrigenStory from '@/components/origen/OrigenStory.astro'
import OrigenPrinciples from '@/components/origen/OrigenPrinciples.astro'
import OrigenPurpose from '@/components/origen/OrigenPurpose.astro'
import OrigenPortfolio from '@/components/origen/OrigenPortfolio.astro'
import OrigenBrand from '@/components/origen/OrigenBrand.astro'
import OrigenCta from '@/components/origen/OrigenCta.astro'
import { colecciones } from '@/data/content/lineas'

const principles = [
    [
        '01',
        'Calidad sin concesiones',
        'Ingredientes seleccionados y procesos cuidados para una experiencia consistente.',
    ],
    [
        '02',
        'Innovación constante',
        'Blends y formatos creados para una vida que siempre está cambiando.',
    ],
    [
        '03',
        'Orgullo peruano',
        'Creada en Perú, con identidad propia y una visión que mira hacia el mundo.',
    ],
]
---

<BaseLayout
    title="Origen | SUNKA Herbal Tea"
    description="Conoce el origen de SUNKA: una marca peruana de té e infusiones creada para transformar cada taza en una experiencia que permanezca."
>
    <div class="origin-page bg-sunka-cream text-sunka-ink">
        <OrigenHero />
        <OrigenStory />
        <OrigenPrinciples principles={principles} />
        <OrigenPurpose />
        <OrigenPortfolio colecciones={colecciones} />
        <OrigenBrand />
        <OrigenCta />
    </div>

    <style is:global>
        .principles-section {
            background-image:
                radial-gradient(circle at 18% 28%, rgba(181, 139, 71, 0.08), transparent 26%),
                radial-gradient(circle at 78% 72%, rgba(181, 139, 71, 0.07), transparent 30%);
        }
        .origin-hero-image {
            animation: originHeroZoom 12s ease-in-out infinite alternate;
        }

        .origin-story-image {
            animation: originStoryZoom 14s ease-in-out infinite alternate;
        }

        @keyframes originHeroZoom {
            from {
                transform: scale(1);
            }

            to {
                transform: scale(1.06);
            }
        }

        @keyframes originStoryZoom {
            from {
                transform: scale(1);
            }

            to {
                transform: scale(1.04);
            }
        }

        .kicker {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.28em;
            text-transform: uppercase;
        }
        .hero .kicker {
            font-size: 12px;
        }
        .button-origin {
            display: inline-flex;
            min-height: 44px;
            align-items: center;
            justify-content: center;
            padding: 0 24px;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            transition: 0.3s ease;
        }
        .purpose-card {
            position: relative;
            display: block;
            overflow: hidden;
            border-radius: 0.375rem;
            color: var(--sunka-white);
        }
        .purpose-card img {
            height: 100%;
            width: 100%;
            object-fit: cover;
            transition: transform 0.8s ease;
        }
        .purpose-card:hover img {
            transform: scale(1.04);
        }
        .purpose-card-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(3, 8, 5, 0.02) 28%, rgba(3, 8, 5, 0.9) 100%);
        }
        .purpose-card > span {
            position: absolute;
            right: 28px;
            bottom: 26px;
            left: 28px;
            display: flex;
            max-width: 620px;
            flex-direction: column;
        }
        .purpose-card small {
            margin-bottom: 10px;
            color: var(--sunka-brass-light);
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.28em;
            text-transform: uppercase;
        }
        .purpose-card strong {
            max-width: 620px;
            font-family: var(--font-sans);
            font-size: 20px;
            font-weight: 600;
            line-height: 1.2;
        }
        .purpose-card-main strong {
            font-size: 24px;
            line-height: 1.12;
        }
        .purpose-card em {
            margin-top: 8px;
            color: rgba(255, 253, 248, 0.72);
            font-size: 12px;
            font-style: normal;
            line-height: 1.5;
        }
        .card {
            position: relative;
            display: block;
            overflow: hidden;
            border-radius: 0.375rem;
            color: var(--sunka-white);
        }
        .card > img {
            height: 100%;
            width: 100%;
            object-fit: cover;
            transition: transform 0.7s ease;
        }
        .card:hover > img {
            transform: scale(1.035);
        }
        .card > div {
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, transparent 34%, rgba(2, 4, 3, 0.82) 100%);
        }
        .card > span {
            position: absolute;
            right: 24px;
            bottom: 24px;
            left: 24px;
            display: flex;
            flex-direction: column;
        }
        .card small {
            margin-bottom: 8px;
            color: var(--sunka-brass-light);
            font-size: 9px;
            font-style: normal;
            font-weight: 600;
            letter-spacing: 0.22em;
            text-transform: uppercase;
        }
        .card strong {
            font-family: var(--font-sans);
            font-size: 20px;
            font-weight: 600;
            line-height: 1.2;
        }
        .card em {
            margin-top: 6px;
            color: rgba(255, 253, 248, 0.68);
            font-size: 12px;
            font-style: normal;
        }
        @media (max-width: 767px) {
            .origin-page h1,
            .origin-page h2 {
                text-wrap: balance;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .origin-hero-image {
                animation: none;
            }

            .origin-story-image {
                animation: none;
            }
        }
    </style>
</BaseLayout>
