---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalLayout from '@/components/legal/LegalLayout.astro';
import PrivacyContent from '@/components/legal/PrivacyContent.astro';

const lastUpdated = '20 de octubre de 2025';

const secciones = [
    { id: 'responsable', texto: '¿Quién es el responsable del tratamiento?' },
    { id: 'que-recogemos', texto: '¿Qué información recopilamos?' },
    { id: 'como-recogemos', texto: '¿Cómo recopilamos esa información?' },
    { id: 'finalidades', texto: 'Finalidades y base legal' },
    { id: 'seguridad', texto: '¿Cómo protegemos tu información?' },
    {
        id: 'transferencias',
        texto: 'Transferencias nacionales e internacionales',
    },
    { id: 'redes-sociales', texto: 'Redes sociales' },
    { id: 'menores', texto: 'Privacidad de menores de edad' },
    {
        id: 'desiciones-automatizadas',
        texto: 'Decisiones automatizadas y elaboración de perfiles',
    },
    { id: 'cambios', texto: 'Cambios en la política de privacidad' },
    { id: 'arco', texto: 'Derechos ARCO' },
    { id: 'aceptacion', texto: 'Aceptación de la política de privacidad' },
];
---

<BaseLayout
    title="Política de privacidad"
    description="Política de privacidad y manejo de datos personales de SUNKA."
>
    <LegalLayout heading="PÓLITICA DE PRIVACIDAD" updatedAt={lastUpdated} updatedSize="sm">
        <PrivacyContent secciones={secciones} />
    </LegalLayout>
</BaseLayout>
