---
import BaseLayout from '@/layouts/BaseLayout.astro'
import LineaHero from '@/components/lineas/LineaHero.astro'
import LineaMomentos from '@/components/lineas/LineaMomentos.astro'
import LineaProductosDestacados from '@/components/lineas/LineaProductosDestacados.astro'
import LineaIdealParaTi from '@/components/lineas/LineaIdealParaTi.astro'
import LineaDiferencia from '@/components/lineas/LineaDiferencia.astro'
import LineaPreparacion from '@/components/lineas/LineaPreparacion.astro'
import { getLineaBySlug } from '@/data/content/lineas'
import { getStoreProducts } from '@/lib/server/catalog/service'

const lineaConfig = getLineaBySlug(Astro.params.slug || '')

if (!lineaConfig) {
    return Astro.rewrite('/404')
}

const productosDestacadosIds = lineaConfig.productosDestacadosIds ?? []
const productosDestacados = productosDestacadosIds.length
    ? (await getStoreProducts(productosDestacadosIds)).map((producto) => ({
          id: producto.id,
          name: producto.name,
          description: producto.short_description || producto.description,
          image: producto.photo,
          imageAlt: producto.photos?.[0]?.name ?? producto.name,
          href: `/productos/${producto.slug}`,
      }))
    : []

const linea = { ...lineaConfig, productosDestacados }

const siteUrl = Astro.site ?? new URL(Astro.url.origin)
const lineaUrl = new URL(`/lineas/${linea.slug}`, siteUrl).href

const jsonLd = [
    {
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        '@id': lineaUrl,
        name: linea.title,
        description: linea.description,
        url: lineaUrl,
        inLanguage: 'es-PE',
        isPartOf: { '@id': new URL('/#website', siteUrl).href },
        mainEntity: {
            '@type': 'ItemList',
            name: linea.title,
            itemListElement: productosDestacados.map((producto, index) => ({
                '@type': 'ListItem',
                position: index + 1,
                name: producto.name,
                url: new URL(producto.href, siteUrl).href,
            })),
        },
    },
    {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', siteUrl).href },
            {
                '@type': 'ListItem',
                position: 2,
                name: 'Tienda',
                item: new URL('/tienda', siteUrl).href,
            },
            { '@type': 'ListItem', position: 3, name: linea.title, item: lineaUrl },
        ],
    },
]
---

<BaseLayout
    title={linea.seoTitle}
    description={linea.description}
    image={linea.heroImage?.src}
    jsonLd={jsonLd}
>
    <LineaHero linea={linea} />
    <LineaMomentos linea={linea} />
    <LineaProductosDestacados linea={linea} />
    <LineaDiferencia linea={linea} />
    <LineaPreparacion />
    <LineaIdealParaTi linea={linea} />
</BaseLayout>
