---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalLayout from '@/components/legal/LegalLayout.astro';
import ShippingContent from '@/components/legal/ShippingContent.astro';

const lastUpdated = '20 de octubre de 2025';
---

<BaseLayout
    title="Términos y condiciones"
    description="Consulta los términos y condiciones de Sunka. Conoce las políticas que regulan el uso de nuestros servicios y la protección de tus datos personales, garantizando transparencia y confianza."
>
    <LegalLayout heading="POLÍTICA DE DESPACHO" updatedAt={lastUpdated}>
        <ShippingContent />
    </LegalLayout>
</BaseLayout>
