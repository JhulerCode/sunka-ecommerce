---
import BaseLayout from '@/layouts/BaseLayout.astro'
import ProductBreadcrumb from '@/components/producto/ProductBreadcrumb.astro'
import ProductHero from '@/components/producto/ProductHero.astro'
import ProductStory from '@/components/producto/ProductStory.astro'
import ProductHighlights from '@/components/producto/ProductHighlights.astro'
import ProductPreparation from '@/components/producto/ProductPreparation.astro'
import ProductRelated from '@/components/producto/ProductRelated.astro'
import { getStoreProductBySlug, getStoreProducts } from '@/lib/server/catalog/service'
import { getProductContentById } from '@/lib/server/catalog/content'
import {
    buildProductDetailView,
    getRelatedArticleIds,
    resolveProductSlug,
} from '@/lib/server/catalog/product-detail'

const rawSlug = Astro.params.slug ?? ''
const isAuthenticated = Astro.locals.session?.status === 'authenticated'
const requestedSlug = resolveProductSlug(rawSlug)

let storeProduct = await getStoreProductBySlug(requestedSlug)

if (!storeProduct) {
    const legacyContent = getProductContentById(requestedSlug)
    if (legacyContent) storeProduct = await getStoreProductBySlug(legacyContent.slug)
}

if (!storeProduct) return Astro.rewrite('/404')

const producto = storeProduct.product
const canonicalSlug = String(producto.slug)

if (rawSlug !== canonicalSlug) {
    return Astro.redirect(`/productos/${canonicalSlug}`, 301)
}

const relatedIds = getRelatedArticleIds(producto)
const relacionados = relatedIds.length ? await getStoreProducts(relatedIds) : []
const view = buildProductDetailView({ producto, isAuthenticated, relacionados })

const siteUrl = Astro.site ?? new URL(Astro.url.origin)
const productUrl = new URL(`/productos/${view.canonicalSlug}`, siteUrl).href
const productImages = view.fotos
    .map((foto: Record<string, any>) => (typeof foto?.url === 'string' ? foto.url : ''))
    .filter(Boolean)
    .map((url) => new URL(url, siteUrl).href)
const priceValue = Number(view.producto.price)
const hasPrice = Number.isFinite(priceValue) && priceValue > 0
const sku = String(view.producto.article_id ?? view.producto.id)

const jsonLd = [
    {
        '@context': 'https://schema.org',
        '@type': 'Product',
        '@id': productUrl,
        name: view.producto.name,
        description: view.pageDescription,
        sku,
        image: productImages.length ? productImages : [new URL('/og-image.png', siteUrl).href],
        url: productUrl,
        brand: { '@type': 'Brand', name: 'SUNKA Herbal Tea' },
        category: view.linea || 'Infusiones',
        offers: {
            '@type': 'Offer',
            url: productUrl,
            priceCurrency: 'PEN',
            ...(hasPrice ? { price: priceValue.toFixed(2) } : {}),
            availability: 'https://schema.org/InStock',
            itemCondition: 'https://schema.org/NewCondition',
            seller: { '@id': new URL('/#organization', siteUrl).href },
        },
    },
    {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', siteUrl).href },
            {
                '@type': 'ListItem',
                position: 2,
                name: 'Tienda',
                item: new URL('/tienda', siteUrl).href,
            },
            { '@type': 'ListItem', position: 3, name: view.producto.name, item: productUrl },
        ],
    },
]
---

<BaseLayout
    title={view.pageTitle}
    description={view.pageDescription}
    image={view.fotoPrincipal}
    type="product"
    canonical={productUrl}
    jsonLd={jsonLd}
>
    <article class="overflow-hidden bg-sunka-white text-sunka-ink">
        <ProductBreadcrumb view={view} />
        <ProductHero view={view} />
        <ProductStory view={view} />
        <ProductHighlights view={view} />
        <ProductPreparation view={view} />
        <ProductRelated view={view} />
    </article>
</BaseLayout>
